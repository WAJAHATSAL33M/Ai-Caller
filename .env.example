# Backend: keep these values in your hosting provider's secret environment, not in Git.
OPENAI_API_KEY=replace_me
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/sales_db
COMPANY_NAME=Your Call Center
COMPANY_WEBSITE=https://example.com
SALES_EMAIL=sales@example.com
PUBLIC_BASE_URL=https://your-public-backend.example
SALES_VOICE=marin
SALES_MODEL=gpt-realtime-2.1
# Only statements the agent is allowed to claim. Supply YOUR verified offerings and pricing.
APPROVED_SALES_FACTS=
# Twilio Programmable Voice (only after opening a Twilio account)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Generate a strong private random admin key. Never use it in browser JavaScript.
SALES_ADMIN_KEY=
# Deliberate safety switch: set true only after authorized calling setup and legal review.
ENABLE_OUTBOUND_CALLS=false
# Legacy SIP starter (not used by Twilio integration)
SIP_PROVIDER_URL=
SIP_USERNAME=
SIP_PASSWORD=
SIP_CALLER_NUMBER=
